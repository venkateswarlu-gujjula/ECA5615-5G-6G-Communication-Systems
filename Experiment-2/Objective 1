clc;
clear;
close all;
% TDMA Parameters
FrameTime = 4.615;      % Frame duration in ms
Slots = 8;              % Number of time slots
SlotDuration = FrameTime / Slots;
% Time vector
t = 0:SlotDuration:FrameTime;
% Create figure
figure;
% Plot 1: TDMA Time Slot Structure
subplot(2,1,1);
stem(t, ones(size(t)), 'filled');
title('TDMA Time Slot Structure');
xlabel('Time (ms)');
ylabel('Slot Level');
grid on;
% Plot 2: Continuous Slot Allocation
subplot(2,1,2);
plot(t, ones(size(t)), '-o', 'LineWidth', 1.5);
title('Continuous View of Slot Allocation');
xlabel('Time (ms)');
ylabel('Slot Presence');
grid on;
