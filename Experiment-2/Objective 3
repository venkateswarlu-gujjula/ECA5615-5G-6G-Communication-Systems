clc;
clear;
close all;
% Total users
Users = 1:8;
% Available TDMA slots
TotalSlots = 5;
% Initialize allocation vector
Alloc = zeros(1,8);
% Assign slots to the first 'TotalSlots' users
Alloc(1:TotalSlots) = 1;
% Remaining users are blocked
Blocked = 1 - Alloc;
% Display allocation table
disp('User Wise Slot Allocation')
disp(table(Users', Alloc', ...
    'VariableNames', {'User','Status(1=Allocated,0=Blocked)'}))
% Create figure
figure
%-----------------------------
% Graph 1: Slot allocation
%-----------------------------
subplot(2,1,1)
stem(Users, Alloc, 'filled', 'LineWidth', 2)
title('TDMA Slot Allocation per User')
xlabel('User Index')
ylabel('Slot Status (1 = Allocated, 0 = Blocked)')
ylim([-0.2 1.2])
grid on
%-----------------------------
% Graph 2: System utilization
%-----------------------------
subplot(2,1,2)
plot(Users, Alloc, '-o', 'LineWidth', 2)
hold on
plot(Users, Blocked, '-s', 'LineWidth', 2)
title('TDMA Slot Utilization Analysis')
xlabel('User Index')
ylabel('Status')
legend('Allocated', 'Blocked')
grid on
