clc;
clear;
close all;
sysBW = 10e6;
rbWidth = 180e3;
resourceBlocks = floor(sysBW/rbWidth);
userID = 1:6;
rbPerUser = floor(resourceBlocks/length(userID));
rbAllocation = repmat(rbPerUser,1,length(userID));
extraRB = mod(resourceBlocks,length(userID));
rbAllocation(1:extraRB) = rbAllocation(1:extraRB) + 1;
rbUsage = (rbAllocation/resourceBlocks) * 100;
disp('Total Resource Blocks:')
disp(resourceBlocks)
disp('RB Allocation per User:')
disp(rbAllocation)
figure
subplot(2,1,1)
stem(userID,rbAllocation,'filled','LineWidth',2)
title('OFDMA Resource Block Allocation per User')
xlabel('User Index')
ylabel('Number of Resource Blocks')
grid on
subplot(2,1,2)
plot(userID,rbUsage,'-o','LineWidth',2)
title('OFDMA Resource Block Utilization (%)')
xlabel('User Index')
ylabel('Utilization (%)')
grid on
